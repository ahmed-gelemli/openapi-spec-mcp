# ============================================================
# openapi-spec-serve — environment variables
# Copy this file to .env and fill in your values.
# For Docker/Coolify, set these directly as env vars instead.
# ============================================================

# ------ MCP Server ------

# Port the HTTP server listens on (required for HTTP/remote mode).
# When PORT is unset the server runs in stdio mode (local Claude Code use).
PORT=3000

# Bearer token clients must send as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
# Leave empty to disable auth (NOT recommended for public deployments).
MCP_AUTH_TOKEN=

# ------ OpenAPI Gateway ------

# Base URL of your API gateway (no trailing slash).
GATEWAY_URL=https://your-api-gateway.example.com

# Comma-separated list of service names.
# Each service is fetched from: {GATEWAY_URL}/{service-name}/openapi.json
OPENAPI_SERVICES=service-one,service-two,service-three

# To override the URL for a specific service, add:
# OPENAPI_URL_SERVICE_ONE=https://other-host.example.com/service-one/openapi.json

# ------ Download Tuning (optional) ------

# Max parallel downloads (default: min(8, number of services))
# OPENAPI_CONCURRENCY=8

# HTTP timeout in seconds (default: 20)
# OPENAPI_TIMEOUT=20

# Retry attempts on transient errors (default: 3)
# OPENAPI_RETRIES=3
