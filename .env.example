# ============================================================
# openapi-spec-serve — environment variables
# Copy this file to .env and fill in your values.
# For Docker/Coolify, set these directly as env vars instead.
# ============================================================

# ------ MCP Server ------

# Port the HTTP server listens on (required for HTTP/remote mode).
# When PORT is unset the server runs in stdio mode (local Claude Code use).
PORT=3000

# Bearer token clients must send as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
# Leave empty to disable auth (NOT recommended for public deployments).
MCP_AUTH_TOKEN=

# ------ Spec source ------

# Which downloader populates api/. Default: update_specs.py (gateway mode).
# Use update_specs_canvas.py to serve the Canvas LMS API instead.
# SPEC_UPDATE_SCRIPT=update_specs.py

# Timeout in ms for one spec-update run (default: 120000).
# Canvas converts 144 resources, so give it more room.
# SPEC_UPDATE_TIMEOUT_MS=120000

# Minutes between automatic spec refreshes in HTTP mode (default: 45).
# Set 0 to disable.
# REFRESH_INTERVAL_MIN=45

# ------ OpenAPI Gateway ------

# Base URL of your API gateway (no trailing slash).
GATEWAY_URL=https://your-api-gateway.example.com

# Comma-separated list of service names.
# Each service is fetched from: {GATEWAY_URL}/{service-name}/openapi.json
OPENAPI_SERVICES=service-one,service-two,service-three

# To override the URL for a specific service, add:
# OPENAPI_URL_SERVICE_ONE=https://other-host.example.com/service-one/openapi.json

# ------ Canvas LMS mode (SPEC_UPDATE_SCRIPT=update_specs_canvas.py) ------

# Base URL of the Canvas instance. Specs come from {CANVAS_URL}/doc/api/
# and live calls go to {CANVAS_URL}/api.
# CANVAS_URL=https://na.instructure.com

# Optional: limit conversion to a subset of resources (default: all 144).
# CANVAS_RESOURCES=courses,assignments,users

# ------ call_endpoint (live requests) ------

# "service" (default) builds GATEWAY_URL/{service}{path}.
# "flat" builds GATEWAY_URL{path} — correct for a single API like Canvas.
# GATEWAY_MODE=service

# Token sent as "Authorization: Bearer <token>" on every call_endpoint request,
# unless the caller passes its own Authorization header.
# For Canvas this is a user access token from /profile/settings.
# API_BEARER_TOKEN=

# ------ Download Tuning (optional) ------

# Max parallel downloads (default: min(8, number of services))
# OPENAPI_CONCURRENCY=8

# HTTP timeout in seconds (default: 20)
# OPENAPI_TIMEOUT=20

# Retry attempts on transient errors (default: 3)
# OPENAPI_RETRIES=3
